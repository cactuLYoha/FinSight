# Use backend/docker_env.py to generate .env.docker with fresh random keys.
POSTGRES_DB=finsight
POSTGRES_USER=finsight
POSTGRES_PASSWORD=
SECRET_KEY=
JWT_SECRET_KEY=
API_PORT=5000
FRONTEND_PORT=4200
# Optional override; Compose defaults to localhost and 127.0.0.1 on FRONTEND_PORT.
# AUTH_TRUSTED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# Use true when the frontend is served over HTTPS.
JWT_COOKIE_SECURE=false
CORS_ORIGINS=
# Complete GMAIL_SETUP.md before deploying mandatory email verification.
# Sender email is read from .env.gmail by the API service.
GMAIL_TOKEN_PATH=./secrets/gmail_token.json
